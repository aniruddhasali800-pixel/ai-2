{
  "framework": null,
  "installCommand": "sh -c 'cd frontend 2>/dev/null || cd ../frontend; npm ci'",
  "buildCommand": "sh -c 'R=$PWD; cd frontend 2>/dev/null || cd ../frontend; npm run build && rm -rf \"$R/dist\" && cp -r dist \"$R/dist\"'",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ai-1-hsus.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://ai-1-hsus.onrender.com/uploads/$1" },
    { "source": "/socket.io/(.*)", "destination": "https://ai-1-hsus.onrender.com/socket.io/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}