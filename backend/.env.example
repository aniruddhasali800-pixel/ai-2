# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Not read by the API: every record is a file under ARCHIVE_DIR, in this service's own filesystem.
# It stays listed here (and in render.yaml) only so an older deployment's value survives a sync.
MONGODB_URI=

# Where the record folders live. Relative paths are taken from backend/.
# ARCHIVE_DIR=.data/archive

ACCESS_TOKEN_SECRET=change-me-dev-access-secret-000000
REFRESH_TOKEN_SECRET=change-me-dev-refresh-secret-000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list — both HTTP CORS and the Socket.IO handshake accept every entry.
# Add the LAN address here (e.g. http://192.168.1.42:5173) to let phones on the same
# Wi-Fi connect, and set PUBLIC_BASE_URL to that same address so printed table QR codes,
# guest bill links and payment links point at a host the phone can actually resolve.
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# The signing keys every webhook route verifies with. Each one is trusted to decide something real:
# PAYMENT_WEBHOOK_SECRET settles a bill, SWIGGY and ZOMATO push a paid order into a kitchen,
# WEBSITE_WEBHOOK_SECRET pushes a restaurant's own checkout in as an order. They must be four
# different values: two senders sharing a key is one key, and a message signed for Swiggy would then
# verify as a Zomato order.
#
# The four below are the values this repository publishes, so they are good on a laptop only. On a
# host that has a public address the API answers 503 to every webhook until each of these holds a
# secret nobody can read out of the source, and with NODE_ENV=production it refuses to boot at all.
# Generate independent ones — `openssl rand -hex 32`, or on Windows
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` — paste each into the
# provider's own dashboard as well as here, and never commit the result.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
SWIGGY_WEBHOOK_SECRET=dev-swiggy-secret
ZOMATO_WEBHOOK_SECRET=dev-zomato-secret
WEBSITE_WEBHOOK_SECRET=dev-website-secret

# Rotation window, left unset until you are actually moving a provider onto a new key. Put the
# outgoing secret here and deliveries still signed with it keep being believed while the gateway
# works through what it queued before its endpoint was re-pointed — Razorpay retries for a day.
# Clear each one when the provider's delivery log shows nothing left to retry, because an old key
# honoured forever is a second signing key, not a retired one. A value this repository publishes is
# never accepted here, and a production process refuses to start on one: the reason for the rotation
# is that those strings are public.
# PAYMENT_WEBHOOK_SECRET_PREVIOUS=
# SWIGGY_WEBHOOK_SECRET_PREVIOUS=
# ZOMATO_WEBHOOK_SECRET_PREVIOUS=
# WEBSITE_WEBHOOK_SECRET_PREVIOUS=
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Optional payment gateway (mock provider is used when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay's own webhook key, set in its dashboard. Unlike the four above nothing is published for it,
# and an unset value rejects every Razorpay delivery rather than falling back to another secret.
RAZORPAY_WEBHOOK_SECRET=

# The bill service (the `bill/` app) — the payee UPI ID, the guest's pay page, the
# verification queue and the income figures live there, not here.
# Leave both blank to keep this build on its own UPI handle and the sandbox gateway.
# When set, every finalised bill raises a UPI request by itself and the counter shows
# that QR. BILL_SERVICE_SHARED_SECRET must equal SIZZLE_SHARED_SECRET in ../bill/.env
# (run `npm run setup:env` in bill/ to print the matching pair). `npm run dev` in both
# folders is enough — nothing else to install.
BILL_SERVICE_BASE_URL=http://localhost:3100
BILL_SERVICE_SHARED_SECRET=
# The key header names this caller; must equal PAY_SERVICE_KEY in ../bill/.env.
BILL_SERVICE_KEY=sizzle-pay

# Deployment. With NODE_ENV=production the API refuses to boot unless ACCESS_TOKEN_SECRET and
# REFRESH_TOKEN_SECRET hold values that are neither the development defaults nor this template's
# change-me strings, and unless all four webhook secrets above hold a value of their own that nobody
# could guess out of this repository.
#
# When ../frontend/dist exists, this process also serves the built React app, so a
# single service on a single port carries the site, /api, /uploads and /socket.io.
# Set STATIC_DIR only if the client lives somewhere unusual.
# STATIC_DIR=../frontend/dist
#
# CORS_ORIGIN and PUBLIC_BASE_URL already default to RENDER_EXTERNAL_URL when a host
# publishes its own address that way, so QR codes and the socket allowlist follow the
# domain you deployed on. Override them for any other host.
#
# Booting against an empty database loads the demo tenant; set false for a clean install.
# AUTO_SEED=false
#
# The one credential that lets a request past the sign-in rate limit, so a staged load run measures
# the service instead of its own throttling. Leave it unset — with nothing here, no request is ever
# skipped, and a production process refuses to start while it holds a value. Set it only on a staging
# instance, and pass it to load-test/load-test.js in its own environment.
# LOAD_TEST_TOKEN=
#
# Demo logins. A fresh checkout sets neither, and that is the point: the seed still builds the
# restaurant, its menu, its tables and fourteen days of history, but it writes no password onto any
# of those staff rows, so nothing that ships with this repository opens anything. Set
# DEMO_STAFF_PASSWORD to give every seeded staff account one password for a local walk-through (the
# accounts sign in by phone number, since the seed gives them no email). DEMO_MASTER_PASSWORD is the
# separate door that opens any active account of the demo tenant without its own password.
# DEMO_STAFF_PASSWORD=
# DEMO_MASTER_PASSWORD=


# ── Authentication & Clerk Integration ──
# Get your Clerk keys from https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── SMTP Real Email Delivery ──
# Configure your email provider to send real OTP verification codes and welcome emails
# Example for Gmail:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-restaurant-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Sizzle Restaurant OS" <your-restaurant-email@gmail.com>
